library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity mode_controller_tb is
end mode_controller_tb;

architecture sim of mode_controller_tb is

    constant CLK_PERIOD : time := 10 ns;

    signal clk        : std_logic := '0';
    signal resetn     : std_logic := '0';
    signal sw_night   : std_logic := '0';
    signal night_mode : std_logic;

begin

    -- mode_controller has no generics any more
    uut : entity work.mode_controller
        port map ( clk => clk, resetn => resetn, sw_night => sw_night,
                   night_mode => night_mode );

    clk <= not clk after CLK_PERIOD / 2;

    stim : process
    begin
        -- Reset
        resetn <= '0';
        wait for 3 * CLK_PERIOD;
        resetn <= '1';

        -- Day: night_mode stays 0
        wait for 5 * CLK_PERIOD;
        assert night_mode = '0' report "Day: night_mode should be 0" severity error;

        -- Flip to night. The 2-flop synchronizer plus night_reg adds
        -- 3 clock cycles of latency, so wait 5 for margin.
        sw_night <= '1';
        wait for 5 * CLK_PERIOD;
        assert night_mode = '1' report "Night: night_mode should be 1" severity error;

        -- Back to day
        sw_night <= '0';
        wait for 5 * CLK_PERIOD;
        assert night_mode = '0' report "Day again: night_mode should be 0" severity error;

        -- Reset while in night mode must force night_mode back to 0
        sw_night <= '1';
        wait for 5 * CLK_PERIOD;
        resetn <= '0';
        wait for 2 * CLK_PERIOD;
        assert night_mode = '0' report "Reset: night_mode should be 0" severity error;
        resetn <= '1';

        report "mode_controller_tb finished";
        wait;
    end process;

end sim;
